{
    "manifest_version": 3,
    "name": "Env Injector",
    "version": "1.0",
    "description": "拦截并复写页面 env.js 中定义的 window.__ENV__ 对象",
    "action": {
        "default_popup": "html/popup.html",
        "default_icon": "icons/icon.png"
    },
    "background": {
        "service_worker": "js/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "js/env_injector.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "js/content_script.js"
            ],
            "run_at": "document_start"
        }
    ],
    "permissions": [
        "activeTab",
        "scripting",
        "tabs",
        "storage"
    ]
}
